{
    "name": "ondrejbakan/steamappticket",
    "description": "Modern, dependency-free PHP library for parsing and validating Steam app tickets.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "steam",
        "steam-app-ticket",
        "app-ticket",
        "authentication",
        "steamid"
    ],
    "authors": [
        {
            "name": "Ondřej Bakan",
            "email": "ondrej@bakan.cz"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-ctype": "*",
        "ext-hash": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.68",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "OndrejBakan\\SteamAppTicket\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OndrejBakan\\SteamAppTicket\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "stan": "@php vendor/bin/phpstan analyse --no-progress",
        "cs": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "@php vendor/bin/php-cs-fixer fix",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    }
}
