{
    "name": "ondrejbakan/steam-appticket",
    "description": "Modern PHP 8.4+ library for parsing and validating Steam app tickets. Unified port of node-steam-appticket and steam-appticket-go.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "steam",
        "appticket",
        "authentication",
        "steamid"
    ],
    "authors": [
        {
            "name": "Ondřej Bakan",
            "email": "ondrej@bakan.cz"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.68",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "OndrejBakan\\SteamAppTicket\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OndrejBakan\\SteamAppTicket\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "cs": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "@php vendor/bin/php-cs-fixer fix",
        "stan": "@php vendor/bin/phpstan analyse --no-progress"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
